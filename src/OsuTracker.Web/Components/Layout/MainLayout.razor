@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IDbContextFactory<TrackerDbContext> DbFactory
@using Microsoft.EntityFrameworkCore
@using OsuTracker.Web.Data
@using OsuTracker.Web.Data.Entities
@using System.Globalization

<div class="shell">
    <header class="appnav">
        <div class="brand">osu<span>!</span>PersonalTracker</div>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All" ActiveClass="active">Dashboard</NavLink>
            <a href="modes/@_lastMode" class="@(OnModes ? "active" : "")">Modes</a>
            <NavLink href="browse" ActiveClass="active">Browse</NavLink>
            <NavLink href="badge" ActiveClass="active">Badge</NavLink>
            <NavLink href="sync" ActiveClass="active">Sync</NavLink>
        </nav>
        <div class="spacer"></div>
        <a class="syncbadge" href="sync" title="@SyncTitle">
            <i class="pulse @SyncClass"></i>
            @SyncLabel
        </a>
    </header>

    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
</div>

@code {
    // Which mode "Modes" opens: the one you are reading while you are in the section,
    // catch everywhere else. The layout is rebuilt on each navigation, so this does not
    // remember the mode once you leave — that would need a cookie, not a field.
    private string _lastMode = "fruits";

    private bool OnModes =>
        Nav.ToBaseRelativePath(Nav.Uri).StartsWith("modes", StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (!OnModes) return;

        var slug = path.Split('/', '?').Skip(1).FirstOrDefault();
        if (!string.IsNullOrEmpty(slug)) _lastMode = slug.ToLowerInvariant();
    }

    // The badge used to be hard-coded green with the word "local", which is a claim, not
    // a status. It now reports the newest job — one small query per page render.
    private SyncJobState? _state;
    private DateTimeOffset? _lastSuccess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var jobs = await db.SyncJobs.ToListAsync();

            if (jobs.Count == 0) return;

            _state = jobs.Any(j => j.State == SyncJobState.Running) ? SyncJobState.Running
                : jobs.Any(j => j.State == SyncJobState.Failed) ? SyncJobState.Failed
                : SyncJobState.Completed;

            _lastSuccess = jobs.Where(j => j.LastSuccessAt is not null)
                               .Max(j => j.LastSuccessAt);
        }
        catch (Exception)
        {
            // The chrome must not take the page down if the database is mid-migration.
            _state = null;
        }
    }

    private TimeSpan? SinceSuccess =>
        _lastSuccess is null ? null : DateTimeOffset.UtcNow - _lastSuccess.Value;

    private string SyncClass => _state switch
    {
        SyncJobState.Running => "",
        SyncJobState.Failed => "failed",
        _ when SinceSuccess is null => "unknown",
        _ when SinceSuccess.Value.TotalHours > 48 => "stale",
        _ => ""
    };

    private string SyncLabel => _state switch
    {
        SyncJobState.Running => "syncing",
        SyncJobState.Failed => "sync failed",
        _ when SinceSuccess is null => "never synced",
        _ => $"synced {Ago(SinceSuccess.Value)}"
    };

    private string SyncTitle => _lastSuccess is null
        ? "No sync job has completed yet"
        : $"Last successful sync: {_lastSuccess.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)} UTC";

    private static string Ago(TimeSpan d) =>
        d.TotalMinutes < 1 ? "just now"
        : d.TotalHours < 1 ? $"{(int)d.TotalMinutes}m ago"
        : d.TotalDays < 1 ? $"{(int)d.TotalHours}h ago"
        : $"{(int)d.TotalDays}d ago";
}
