@page "/browse"
@using OsuTracker.Web.Data.Entities
@using OsuTracker.Web.Services
@using System.Globalization
@inject BrowseQueryService Query
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Browse · osu!PersonalTracker</PageTitle>

<div class="mode-head">
    <h1 class="mode-title" tabindex="-1">Browse</h1>
    <span class="mode-sub">every counted difficulty, filtered</span>
</div>

<div class="filters">
    @foreach (var m in Enum.GetValues<GameMode>())
    {
        <button class="f @(m == _filter.Mode ? "on" : "")" style="--mc:@Colour(m)"
                @onclick="() => SetMode(m)">@ModeName(m)</button>
    }

    <span class="f-gap"></span>

    @foreach (var st in new[] { BrowseStatus.All, BrowseStatus.Untouched, BrowseStatus.Attempted, BrowseStatus.Passed, BrowseStatus.PreRankOnly })
    {
        var n = _counts?.GetValueOrDefault(st);
        <button class="f @(st == _filter.Status ? "on" : "")" style="--mc:@Colour(_filter.Mode)"
                @onclick="() => SetStatus(st)">
            @StatusName(st)@(n is null ? "" : $" {N(n.Value)}")
        </button>
    }

    <span class="f-gap"></span>

    <select class="f" aria-label="Sort order" @onchange="SetSort">
        <option value="easiest" selected="@(_filter.Sort == BrowseSort.StarsAsc)">easiest first</option>
        <option value="hardest" selected="@(_filter.Sort == BrowseSort.StarsDesc)">hardest first</option>
        <option value="played" selected="@(_filter.Sort == BrowseSort.PlaysDesc)">most played</option>
        <option value="newest" selected="@(_filter.Sort == BrowseSort.RankedDesc)">newest ranked</option>
        <option value="oldest" selected="@(_filter.Sort == BrowseSort.RankedAsc)">oldest ranked</option>
        <option value="shortest" selected="@(_filter.Sort == BrowseSort.LengthAsc)">shortest first</option>
        <option value="longest" selected="@(_filter.Sort == BrowseSort.LengthDesc)">longest first</option>
    </select>

    <input class="f f-search" type="search" aria-label="Search beatmaps"
           placeholder="search title, artist, mapper, difficulty…"
           value="@_searchText"
           @oninput="e => _searchText = e.Value?.ToString() ?? string.Empty"
           @onkeydown="OnSearchKey" />
    <button class="f f-go" style="--mc:@Colour(_filter.Mode)" @onclick="RunSearch"
            disabled="@(!SearchPending)">search</button>
    @if (!string.IsNullOrEmpty(_filter.Search))
    {
        <button class="f" @onclick="ClearSearch">clear</button>
    }
</div>

@if (_result is null)
{
    <p class="loading">Loading…</p>
}
else
{
    <div class="result-line">
        @N(_result.Total) results
        @if (_result.Total > _result.PageSize)
        {
            <span class="range"> · showing @N(FirstRowNumber)&ndash;@N(LastRowNumber)</span>
        }
        @if (_filter.Status == BrowseStatus.Untouched && _filter.Sort == BrowseSort.StarsAsc)
        {
            <span class="hint"> · easiest never-passed first — the top row is your next map</span>
        }
    </div>

    <div class="table-wrap">
        <table class="dt">
            <thead>
                <tr>
                    <th>Beatmap</th><th>Difficulty</th>
                    <th class="r"><span aria-hidden="true">★</span><span class="sr-only">Star rating</span></th>
                    <th class="r">Length</th>
                    <th>Status</th><th class="r">Grade</th><th class="r">Acc</th>
                    <th>Mods</th><th class="r">Plays</th><th class="r">Ranked</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _result.Rows)
                {
                    <tr>
                        <td>
                            <a class="t-title" href="https://osu.ppy.sh/beatmapsets/@r.BeatmapsetId#@ModeSlug(_filter.Mode)/@r.BeatmapId"
                               target="_blank" rel="noopener">@r.Title</a>
                            <div class="t-artist">@r.Artist · @r.Creator</div>
                        </td>
                        <td class="mono">@r.Difficulty</td>
                        <td class="r mono">@r.StarRating.ToString("F2", CultureInfo.InvariantCulture)</td>
                        <td class="r mono">@Duration(r.TotalLength)</td>
                        <td><span class="chip @ChipClass(r.State)">@StatusName(r.State)</span></td>
                        <td class="r">
                            @if (r.Grade is null)
                            {
                                <span class="dim">@Dash</span>
                            }
                            else
                            {
                                <span class="grade g-@r.Grade.ToLowerInvariant()">@r.Grade</span>
                            }
                        </td>
                        <td class="r mono">
                            @(r.Accuracy is null
                                ? Dash
                                : (r.Accuracy.Value * 100).ToString("F2", CultureInfo.InvariantCulture) + "%")
                        </td>
                        <td class="mono mods">
                            @if (string.IsNullOrEmpty(r.Mods))
                            {
                                <span class="dim">@Dash</span>
                            }
                            else
                            {
                                @foreach (var mod in r.Mods.Split(','))
                                {
                                    <span class="@(mod == "NF" ? "mod-nf" : "mod")">@mod</span>
                                }
                            }
                        </td>
                        <td class="r mono">@N(r.PlayCount)</td>
                        <td class="r mono dim">@(r.RankedDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    </tr>
                }
                @if (_result.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="empty">
                            Nothing matches those filters.
                            @if (HasFilters)
                            {
                                <a class="f" style="margin-left: 12px" href="@UrlFor(Defaults with { Mode = _filter.Mode })">clear filters</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_result.PageCount > 1)
    {
        <div class="pager">
            <button class="f" disabled="@(_filter.Page == 0)" @onclick="() => GoTo(0)"
                    aria-label="First page">&laquo; first</button>
            <button class="f" disabled="@(_filter.Page == 0)" @onclick="() => GoTo(_filter.Page - 1)">&lsaquo; prev</button>

            <span class="pager-jump">
                page
                <input class="f pager-input" type="number" min="1" max="@_result.PageCount"
                       value="@(_filter.Page + 1)" @onchange="JumpTo" aria-label="Page number" />
                of @N(_result.PageCount)
            </span>

            <button class="f" disabled="@(_filter.Page >= _result.PageCount - 1)" @onclick="() => GoTo(_filter.Page + 1)">next &rsaquo;</button>
            <button class="f" disabled="@(_filter.Page >= _result.PageCount - 1)" @onclick="() => GoTo(_result.PageCount - 1)"
                    aria-label="Last page">last &raquo;</button>
        </div>
    }
}

@code {
    // The filter lives in the URL, not in the component. Every control below navigates,
    // and the page reads its state back out of the query string — so a view can be
    // shared, bookmarked and reloaded, and the back button undoes one filter at a time.
    [SupplyParameterFromQuery(Name = "mode")]   public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")]   public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")]      public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "page")]   public int? PageQuery { get; set; }

    private BrowseFilter _filter = new();
    private BrowseResult? _result;
    private Dictionary<BrowseStatus, int>? _counts;

    // What is in the box right now, which is deliberately not what the table shows:
    // the query only moves when the user asks for it.
    private string _searchText = string.Empty;

    private const string Dash = "—";

    // Defaults stay out of the URL, so the everyday view is "/browse" rather than four
    // parameters that say nothing.
    private static readonly BrowseFilter Defaults = new();

    protected override async Task OnParametersSetAsync()
    {
        var next = new BrowseFilter
        {
            Mode = ParseMode(ModeQuery),
            Status = ParseStatus(StatusQuery),
            Sort = ParseSort(SortQuery),
            Search = string.IsNullOrWhiteSpace(SearchQuery) ? null : SearchQuery.Trim(),
            // 1-based in the URL, because that is the number the pager shows.
            Page = Math.Max(0, (PageQuery ?? 1) - 1)
        };

        // BrowseFilter is a record, so an unrelated re-render costs no queries.
        if (_result is not null && next == _filter) return;

        var modeChanged = _counts is null || next.Mode != _filter.Mode;
        _filter = next;

        // The URL is the source of truth, so the box follows it — on a shared link, the
        // back button, or any other filter that rewrites the query string.
        _searchText = _filter.Search ?? string.Empty;

        if (modeChanged) _counts = await Query.GetStatusCountsAsync(_filter.Mode);
        _result = await Query.QueryAsync(_filter);

        // A hand-edited or stale page number lands past the end. Send it to the last real
        // page rather than showing an empty table that reads as a broken filter.
        if (_result.Rows.Count == 0 && _result.Total > 0 && _filter.Page > 0)
            Nav.NavigateTo(UrlFor(_filter with { Page = _result.PageCount - 1 }), replace: true);
    }

    private void SetMode(GameMode m) => Apply(_filter with { Mode = m, Page = 0 });
    private void SetStatus(BrowseStatus st) => Apply(_filter with { Status = st, Page = 0 });
    private void GoTo(int page) => Apply(_filter with { Page = page });

    /// <summary>
    /// Typing a page number beats pressing "next" 2,600 times, which is what browsing
    /// 130,937 untouched osu! maps used to cost.
    /// </summary>
    private void JumpTo(ChangeEventArgs e)
    {
        if (_result is null) return;
        if (!int.TryParse(e.Value?.ToString(), out var oneBased)) return;

        var page = Math.Clamp(oneBased, 1, _result.PageCount) - 1;
        if (page != _filter.Page) GoTo(page);
    }

    private int FirstRowNumber => _result is null ? 0 : _filter.Page * _result.PageSize + 1;

    private int LastRowNumber => _result is null
        ? 0
        : Math.Min(_filter.Page * _result.PageSize + _result.Rows.Count, _result.Total);

    private void SetSort(ChangeEventArgs e) =>
        Apply(_filter with { Sort = ParseSort(e.Value?.ToString()), Page = 0 });

    /// <summary>
    /// Whether the box holds something the table is not showing yet — which is also the
    /// only time the search button does anything, so it is disabled otherwise.
    /// </summary>
    private bool SearchPending => Normalise(_searchText) != _filter.Search;

    /// <summary>
    /// Search commits on the button or Enter, never on a keystroke. Typing a nine-letter
    /// title used to cost nine full-table queries over 130,937 rows to reach one answer.
    /// </summary>
    private void RunSearch()
    {
        if (!SearchPending) return;
        Apply(_filter with { Search = Normalise(_searchText), Page = 0 });
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") RunSearch();
    }

    private void ClearSearch()
    {
        _searchText = string.Empty;
        Apply(_filter with { Search = null, Page = 0 });
    }

    private static string? Normalise(string? s) =>
        string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    /// <summary>Anything the user chose, as opposed to how the page opens.</summary>
    private bool HasFilters => _filter != Defaults with { Mode = _filter.Mode };

    /// <summary>Each change is its own history entry, so back means "undo that filter".</summary>
    private void Apply(BrowseFilter f) => Nav.NavigateTo(UrlFor(f));

    private string UrlFor(BrowseFilter f) =>
        Nav.GetUriWithQueryParameters(Nav.ToAbsoluteUri("browse").ToString(), new Dictionary<string, object?>
        {
            ["mode"] = f.Mode == Defaults.Mode ? null : ModeSlug(f.Mode),
            ["status"] = f.Status == Defaults.Status ? null : StatusSlug(f.Status),
            ["sort"] = f.Sort == Defaults.Sort ? null : SortSlug(f.Sort),
            ["q"] = string.IsNullOrWhiteSpace(f.Search) ? null : f.Search.Trim(),
            ["page"] = f.Page == 0 ? null : f.Page + 1
        });

    // Parsing is total: a URL typed by hand falls back to the default rather than
    // erroring, because none of these values can break the query.
    private static GameMode ParseMode(string? s) => s?.ToLowerInvariant() switch
    {
        "osu" or "standard" => GameMode.Osu,
        "taiko" => GameMode.Taiko,
        "mania" => GameMode.Mania,
        "fruits" or "catch" => GameMode.Fruits,
        _ => Defaults.Mode
    };

    private static BrowseStatus ParseStatus(string? s) => s?.ToLowerInvariant() switch
    {
        "all" => BrowseStatus.All,
        "attempted" => BrowseStatus.Attempted,
        "passed" => BrowseStatus.Passed,
        "prerank" or "pre-rank" => BrowseStatus.PreRankOnly,
        "untouched" => BrowseStatus.Untouched,
        _ => Defaults.Status
    };

    private static BrowseSort ParseSort(string? s) => s?.ToLowerInvariant() switch
    {
        "hardest" => BrowseSort.StarsDesc,
        "played" => BrowseSort.PlaysDesc,
        "newest" => BrowseSort.RankedDesc,
        "oldest" => BrowseSort.RankedAsc,
        "shortest" => BrowseSort.LengthAsc,
        "longest" => BrowseSort.LengthDesc,
        _ => Defaults.Sort
    };

    private static string ModeSlug(GameMode m) => m switch
    {
        GameMode.Osu => "osu", GameMode.Taiko => "taiko",
        GameMode.Fruits => "fruits", GameMode.Mania => "mania", _ => "fruits"
    };

    private static string StatusSlug(BrowseStatus s) => s switch
    {
        BrowseStatus.All => "all",
        BrowseStatus.Attempted => "attempted",
        BrowseStatus.Passed => "passed",
        BrowseStatus.PreRankOnly => "prerank",
        _ => "untouched"
    };

    private static string SortSlug(BrowseSort s) => s switch
    {
        BrowseSort.StarsDesc => "hardest",
        BrowseSort.PlaysDesc => "played",
        BrowseSort.RankedDesc => "newest",
        BrowseSort.RankedAsc => "oldest",
        BrowseSort.LengthAsc => "shortest",
        BrowseSort.LengthDesc => "longest",
        _ => "easiest"
    };

    private static string N(int v) => v.ToString("N0", CultureInfo.InvariantCulture);

    /// <summary>Map length as the client shows it: m:ss, and h:mm:ss for the marathons.</summary>
    private static string Duration(int seconds)
    {
        if (seconds <= 0) return Dash;

        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalHours >= 1
            ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}"
            : $"{(int)t.TotalMinutes}:{t.Seconds:00}";
    }

    private static string ChipClass(BrowseStatus s) => s switch
    {
        BrowseStatus.Passed => "passed",
        BrowseStatus.Attempted => "attempted",
        BrowseStatus.PreRankOnly => "prerank",
        _ => "untouched"
    };

    private static string StatusName(BrowseStatus s) => s switch
    {
        BrowseStatus.All => "All",
        BrowseStatus.Untouched => "Untouched",
        BrowseStatus.Attempted => "Attempted",
        BrowseStatus.Passed => "Passed",
        BrowseStatus.PreRankOnly => "Pre-rank",
        _ => s.ToString()
    };

    private static string ModeName(GameMode m) => m switch
    {
        GameMode.Osu => "osu!", GameMode.Taiko => "taiko",
        GameMode.Fruits => "catch", GameMode.Mania => "mania", _ => m.ToString()
    };

    private static string Colour(GameMode m) => m switch
    {
        GameMode.Osu => "var(--osu)", GameMode.Taiko => "var(--taiko)",
        GameMode.Fruits => "var(--fruits)", GameMode.Mania => "var(--mania)", _ => "var(--muted)"
    };
}
