@page "/Error"
@using System.Diagnostics

<PageTitle>Error · osu!PersonalTracker</PageTitle>

<div class="mode-head">
    <h1 class="mode-title" tabindex="-1">Something went wrong</h1>
    <span class="mode-sub">the request failed before the page could render</span>
</div>

<div class="panel">
    <div class="panel-title">
        <h2>What to try</h2>
        @if (ShowRequestId)
        {
            <b>request @RequestId</b>
        }
    </div>

    <p class="pace-none">
        Reload the page. If it fails again, the server log has the exception under the request
        ID above. Running with <b>ASPNETCORE_ENVIRONMENT=Development</b> shows it here instead,
        which is fine on this machine and never on a public address.
    </p>

    <div class="filters" style="margin-top: 16px">
        <a class="f on" style="--mc: var(--osu)" href="">dashboard</a>
        <a class="f" href="sync">sync</a>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
