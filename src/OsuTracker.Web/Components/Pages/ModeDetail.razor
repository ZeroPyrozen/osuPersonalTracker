@page "/modes/{Mode}"
@using OsuTracker.Web.Data.Entities
@using OsuTracker.Web.Services
@using System.Globalization
@inject ProgressQueryService Progress
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>@ModeName(_mode) · osu!PersonalTracker</PageTitle>

<div class="mode-head">
    <h1 class="mode-title" tabindex="-1" style="color:@Colour(_mode)">@ModeName(_mode)</h1>
    @if (_row is not null)
    {
        <span class="mode-sub">
            @N(_row.Total) native difficulties · ranked + approved · converts excluded
        </span>
    }
</div>

<div class="filters">
    @foreach (var m in Enum.GetValues<GameMode>())
    {
        <a class="f @(m == _mode ? "on" : "")" style="--mc:@Colour(m)" href="/modes/@Slug(m)">@ModeName(m)</a>
    }
    <span class="f-gap"></span>
    <a class="f" href="/browse?mode=@Slug(_mode)">browse @ModeName(_mode) →</a>
</div>

@if (_row is null || _bands is null)
{
    <p class="loading">Loading…</p>
}
else
{
    <div class="panel">
        <div class="panel-title">
            <h2>Completion</h2>
            <b>@Pct(_row.PassedPercent)&#37; passed</b>
        </div>
        <div class="bar">
            <i style="width:@W(_row.Passed, _row.Total); background:@Colour(_mode)"></i>
            <i style="width:@W(_row.Attempted, _row.Total); background:var(--warn)"></i>
            <i style="width:@W(_row.Untouched, _row.Total); background:var(--untouched)"></i>
        </div>
        <div class="seg-legend">
            <span><i style="background:@Colour(_mode)"></i>Passed @N(_row.Passed)</span>
            <span>
                <i style="background:var(--warn)"></i>Attempted @N(_row.Attempted)
                <span class="qual">(approximate)</span>
            </span>
            <span><i class="untouched"></i>Untouched @N(_row.Untouched)</span>
        </div>
        <p class="footnote"><b>Attempted is approximate.</b> Playcounts carry no timestamps, so plays from before a map was ranked cannot be told apart from plays since, and they are counted here either way.</p>
    </div>

    <div class="panel">
        <div class="panel-title">
            <h2>By star rating</h2>
            @if (_wall is not null)
            {
                <b>your wall is @_wall</b>
            }
        </div>

        <div class="histo">
            @foreach (var b in _bands)
            {
                var h = _maxBand == 0 ? 0 : (int)Math.Round(118.0 * b.Total / _maxBand);
                <div class="histo-col" title="@b.Label — @N(b.Passed) of @N(b.Total) passed">
                    <div class="histo-pct">@(b.Total == 0 ? "—" : Pct(b.Passed * 100.0 / b.Total) + "%")</div>
                    <div class="histo-stack" style="height:@(Math.Max(h, 3))px;">
                        <i style="height:@Seg(b.Passed, b.Total); background:@Colour(_mode)"></i>
                        <i style="height:@Seg(b.Attempted, b.Total); background:var(--warn)"></i>
                        <i style="height:@Seg(b.Untouched, b.Total); background:var(--untouched)"></i>
                    </div>
                    <div class="histo-x">@b.Label</div>
                </div>
            }
        </div>
        <div class="seg-legend">
            <span>Bar height is how many maps exist in that band; fill is how far through it you are.</span>
        </div>
    </div>

    <div class="split">
        <div class="panel" style="--mc:@Colour(_mode)">
            <div class="panel-title"><h2>Pace</h2><b>last 30 days</b></div>
            @if (_recentPasses == 0)
            {
                <div class="pace-none">
                    No qualifying passes in the last 30 days, so there is no rate to project from.
                </div>
            }
            else if (Remaining == 0)
            {
                <div class="pace-eta">
                    <div class="pace-eta-label">Projected finish</div>
                    <div class="pace-eta-date">Done</div>
                    <div class="pace-eta-away">Every counted difficulty in @ModeName(_mode) is passed.</div>
                </div>
            }
            else
            {
                var eta = PaceProjection.Project(Remaining, PerWeek, DateTimeOffset.UtcNow);
                <div class="pace-eta">
                    <div class="pace-eta-label">Projected finish</div>
                    <div class="pace-eta-date">@eta.Headline</div>
                    <div class="pace-eta-away">@eta.Away · @N(Remaining) difficulties to go</div>
                </div>
                <div class="pace-rate">
                    <b>+@N(_recentPasses)</b> passed in the last 30 days · @Pct(PerWeek) per week
                </div>
            }
        </div>

        <div class="panel">
            <div class="panel-title">
                <h2>Nearly done</h2>
                <b>@(_nearlyTotal == 0 ? "sets part-way through" : N(_nearlyTotal) + " sets part-way through")</b>
            </div>
            @if (_nearly is null || _nearly.Count == 0)
            {
                <div class="pace-none">No partially-completed sets.</div>
            }
            else
            {
                <div class="nearly">
                    @foreach (var s in _nearly)
                    {
                        <a class="nearly-row" href="https://osu.ppy.sh/beatmapsets/@s.BeatmapsetId" target="_blank" rel="noopener">
                            <span class="nearly-text">
                                <span class="nearly-title">@s.Title</span>
                                <span class="nearly-artist">@s.Artist</span>
                            </span>
                            <span class="nearly-count">
                                @s.Done/@s.Total
                                <span class="nearly-left">@s.Remaining left</span>
                            </span>
                        </a>
                    }
                </div>

                <div class="nearly-more">
                    @if (_nearly.Count < _nearlyTotal)
                    {
                        <button class="f" @onclick="LoadMoreNearly" disabled="@_loadingMore">
                            @(_loadingMore ? "loading…" : "show " + NextBatchSize + " more")
                        </button>
                    }
                    <span class="nearly-shown">showing @N(_nearly.Count) of @N(_nearlyTotal)</span>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Mode { get; set; } = "fruits";

    private GameMode _mode = GameMode.Fruits;
    private ModeProgress? _row;
    private List<StarBand>? _bands;
    private List<NearlyDoneSet>? _nearly;
    private int _nearlyTotal;
    private bool _loadingMore;
    private int _recentPasses;
    private int _maxBand;
    private string? _wall;

    private const int FirstBatch = 8;
    private const int MoreBatch = 12;

    protected override async Task OnParametersSetAsync()
    {
        // A slug that names no ruleset is a 404, not catch: rendering real numbers under
        // someone else's URL is worse than saying the page does not exist.
        if (Parse(Mode) is not { } mode)
        {
            Nav.NotFound();
            return;
        }

        _mode = mode;

        var all = await Progress.GetAllModesAsync();
        _row = all.First(r => r.Mode == _mode);
        _bands = await Progress.GetStarBandsAsync(_mode);
        _nearly = await Progress.GetNearlyDoneAsync(_mode, FirstBatch);
        _nearlyTotal = await Progress.GetNearlyDoneCountAsync(_mode);
        _loadingMore = false;
        _recentPasses = await Progress.GetRecentPassCountAsync(_mode, 30);

        _maxBand = _bands.Count == 0 ? 0 : _bands.Max(b => b.Total);
        _wall = FindWall(_bands);
    }

    private int NextBatchSize => Math.Min(MoreBatch, _nearlyTotal - (_nearly?.Count ?? 0));

    /// <summary>
    /// Fetches the next slice rather than re-fetching a longer list: the grouping behind
    /// it walks every counted difficulty in the mode, which is 130,000 rows for osu!.
    /// </summary>
    private async Task LoadMoreNearly()
    {
        if (_nearly is null || _loadingMore) return;

        _loadingMore = true;
        try
        {
            var next = await Progress.GetNearlyDoneAsync(_mode, MoreBatch, _nearly.Count);
            _nearly.AddRange(next);

            // A sync between page load and this click can shrink the list under us.
            // Believe the empty page rather than leaving a button that fetches nothing.
            if (next.Count == 0) _nearlyTotal = _nearly.Count;
        }
        finally { _loadingMore = false; }
    }

    private double PerWeek => _recentPasses / (30 / 7.0);

    private int Remaining => _row is null ? 0 : _row.Untouched + _row.Attempted;

    /// <summary>
    /// The wall is the first band where the pass rate collapses relative to the bands
    /// below it — not simply the lowest rate, which would always be the top band.
    /// </summary>
    private static string? FindWall(List<StarBand> bands)
    {
        var withData = bands.Where(b => b.Total >= 50).ToList();
        if (withData.Count < 3) return null;

        for (var i = 1; i < withData.Count; i++)
        {
            var prev = withData[i - 1];
            var cur = withData[i];
            if (prev.Total == 0 || cur.Total == 0) continue;

            var prevRate = prev.Passed * 100.0 / prev.Total;
            var curRate = cur.Passed * 100.0 / cur.Total;

            if (prevRate >= 10 && curRate < prevRate / 2) return cur.Label;
        }
        return null;
    }

    private static string N(int v) => v.ToString("N0", CultureInfo.InvariantCulture);
    private static string Pct(double v) => v.ToString("F1", CultureInfo.InvariantCulture);

    private static string W(int part, int total) =>
        (total == 0 ? 0 : part * 100.0 / total).ToString("F3", CultureInfo.InvariantCulture) + "%";

    private static string Seg(int part, int total) =>
        (total == 0 ? 0 : part * 100.0 / total).ToString("F2", CultureInfo.InvariantCulture) + "%";

    private static GameMode? Parse(string s) => s.ToLowerInvariant() switch
    {
        "osu" or "standard" => GameMode.Osu,
        "taiko" => GameMode.Taiko,
        "mania" => GameMode.Mania,
        "fruits" or "catch" => GameMode.Fruits,
        _ => null
    };

    private static string Slug(GameMode m) => m switch
    {
        GameMode.Osu => "osu", GameMode.Taiko => "taiko",
        GameMode.Fruits => "fruits", GameMode.Mania => "mania", _ => "fruits"
    };

    private static string ModeName(GameMode m) => m switch
    {
        GameMode.Osu => "osu!", GameMode.Taiko => "osu!taiko",
        GameMode.Fruits => "osu!catch", GameMode.Mania => "osu!mania", _ => m.ToString()
    };

    private static string Colour(GameMode m) => m switch
    {
        GameMode.Osu => "var(--osu)", GameMode.Taiko => "var(--taiko)",
        GameMode.Fruits => "var(--fruits)", GameMode.Mania => "var(--mania)", _ => "var(--muted)"
    };
}
